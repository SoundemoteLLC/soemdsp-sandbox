# Compiled and media files are binary. Do not apply text/CRLF transforms.
*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.wav binary
*.mp3 binary
*.ico binary

# This existing test uses CRLF; keep carriage returns out of whitespace errors.
scripts/test_text_resharpen.mjs whitespace=cr-at-eol
scripts/smoke_release.mjs whitespace=cr-at-eol
public/node-graph-slider-dragging.js whitespace=cr-at-eol
